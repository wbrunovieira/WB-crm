# Database (PostgreSQL)
DATABASE_URL="postgresql://crm_user:dev_password_123@localhost:5499/crm_db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Admin User (for seed)
ADMIN_EMAIL="your-email@example.com"
ADMIN_PASSWORD="your-secure-password"
ADMIN_NAME="Admin User"

# SDR User (optional - for seed)
SDR_EMAIL="sdr@example.com"
SDR_PASSWORD="sdr-password"
SDR_NAME="SDR User"

# Internal API Authentication (for server-to-server communication)
INTERNAL_API_KEY="your-internal-api-key-generate-with-openssl-rand-base64-32"
WEBHOOK_SECRET="your-webhook-secret-generate-with-openssl-rand-base64-32"



# GoTo Connect Integration
GOTO_CLIENT_ID="your-goto-client-id"
GOTO_CLIENT_SECRET="your-goto-client-secret"
GOTO_ACCOUNT_KEY="your-goto-account-key"
GOTO_WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth Integration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# NestJS Backend API
BACKEND_URL=http://localhost:3010

# URL interna do backend, usada SÓ na renderização no servidor das páginas de agendamento.
# Sem ela o SSR sai para a internet e volta pela Cloudflare: medido no servidor, 0,6s a 2,0s
# contra 0,35s interno, e às vezes falha por completo — e a falha vira "link inválido ou
# expirou" para quem ia marcar reunião. O navegador continua usando NEXT_PUBLIC_BACKEND_URL.
BACKEND_INTERNAL_URL=http://localhost:3010
