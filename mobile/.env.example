# Copy to .env (gitignored) and fill in. NEVER commit the real .env — this repo is public.
#
# Long-lived JWT for YOUR CRM user (admin), signed with the backend's JWT_SECRET.
# Mint it inside the prod backend container (the secret never leaves the server):
#   ssh root@45.90.123.190 'docker exec wb-crm-backend node -e "console.log(require(\"jsonwebtoken\").sign({sub:\"<SEU_USER_ID>\",email:\"<seu_email>\",role:\"admin\",name:\"<seu_nome>\"},process.env.JWT_SECRET,{expiresIn:\"365d\"}))"'
# Paste the printed token below.
CRM_JWT=

# Backend base URL (default already points to prod; override for local dev).
CRM_API_URL=https://crm-api.wbdigitalsolutions.com
