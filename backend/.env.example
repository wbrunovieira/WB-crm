META_USER_TOKEN=xxx

DATABASE_URL="postgresql://crm_user:dev_password_123@localhost:5499/crm_db"

# paste here the SAME value as NEXTAUTH_SECRET from root .env
JWT_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
   
# Sincronização de contratos com o financeiro (calendar-finances).
# Sem FINANCE_API_URL o disparo é no-op silencioso — ligar a integração é configuração,
# não deploy de código. Ver o desenho em SyncDealToFinanceUseCase.
FINANCE_API_URL=
FINANCE_API_SECRET=
