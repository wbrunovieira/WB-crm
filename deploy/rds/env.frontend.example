# /opt/wb-crm-rds/.env  — frontend da instância RDS (PM2 wb-crm-rds, porta 3005)
# Nome e porta do container do backend. MORAM AQUI, no .env da raiz, porque é daqui
# que o docker compose interpola ${BACKEND_CONTAINER} / ${BACKEND_PORT}. No backend/.env
# o compose NÃO os veria (lá é env_file, lido só dentro do container) e subiria como
# "wb-crm-backend" na 3010 — colidindo com a instância da WB.
BACKEND_CONTAINER=wb-crm-backend-rds
BACKEND_PORT=3011

NEXT_PUBLIC_BRAND=rds
NEXT_PUBLIC_BACKEND_URL=https://crm-rds-api.wbdigitalsolutions.com
BACKEND_URL=http://localhost:3011
NEXTAUTH_URL=https://crm-rds.wbdigitalsolutions.com
# Gerar próprio: openssl rand -base64 32  (NÃO reusar o do WB)
NEXTAUTH_SECRET=
PORT=3005

# Botão de troca: aponta de volta para a WB
NEXT_PUBLIC_URL_WB=https://crm.wbdigitalsolutions.com
NEXT_PUBLIC_URL_RDS=https://crm-rds.wbdigitalsolutions.com
