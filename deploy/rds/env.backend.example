# /opt/wb-crm-rds/backend/.env — backend da instância RDS (container wb-crm-backend-rds, :3011)
# BACKEND_CONTAINER / BACKEND_PORT ficam no .env da RAIZ (o compose interpola de lá),
# não aqui. Ver env.frontend.example.

# Banco PRÓPRIO (database separado no mesmo Postgres)
DATABASE_URL=postgresql://crm_user:SENHA@crm_postgres:5432/crm_rds?schema=public

# Segredos PRÓPRIOS — devem diferir do WB. JWT_SECRET precisa casar com o
# NEXTAUTH_SECRET do frontend RDS (o NextAuth assina com ele).
JWT_SECRET=
FRONTEND_URL=https://crm-rds.wbdigitalsolutions.com
BACKEND_URL=https://crm-rds-api.wbdigitalsolutions.com

# Integrações: começam DESLIGADAS. Frete não usa as do WB, e deixar vazio é no-op.
# Preencher só o que a RDS realmente for usar.
# EVOLUTION_API_URL=
# GOOGLE_CLIENT_ID=
